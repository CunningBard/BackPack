natural_newline = _{"␍␊" | "\r\n" | "\n"}
explicit_newline = _{";"}
new_line = _{natural_newline | explicit_newline}
line_terminator = _{new_line | EOI}

WHITESPACE = _{ " " | "\t" }
COMMENT = _{ "//" ~ (!natural_newline ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
float = @{ ("-")? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
integer = @{ "-"? ~ ASCII_DIGIT+ }
bool = @{ "true" | "false" }
string = @{ "\"" ~ (("\\\"" | !"\"") ~ ANY)* ~ "\"" }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHA | "_" | ASCII_DIGIT)* }
import_path = @{ (ASCII_ALPHANUMERIC | "_" | "/" | "." | "-")+ }

number = @{ float | integer }

var_type = { list_type | identifier ~ "*"* }

list_type = { "[" ~ var_type ~ "]" }

identifier_with_dots = { identifier ~ ("." ~ identifier)+ }
usable_identifier = { identifier_with_dots | identifier }


function_call = {
    usable_identifier ~ "(" ~ natural_newline* ~ (expr ~ "," ~ natural_newline*)* ~ (expr ~ natural_newline*)? ~ ")" ~ natural_newline*
}
eq_ops = { "==" | "!="  | ">=" | "<=" | ">" | "<"}
and_ops = { "&&" }
or_ops = { "||" }
sum_ops = { "+" | "-" }
prod_ops = { "*" | "/" }

expr = { logical_or }
logical_or = { logical_and ~ (or_ops ~ logical_and)* }
logical_and = { comparison ~ (and_ops ~ comparison)* }
comparison = { sum ~ (eq_ops ~ sum)* }
sum = { product ~ ((sum_ops) ~ product)* }
product = { term ~ ((prod_ops) ~ term)* }
unary_op = { "!" | "-" }
unary = { unary_op ~ term }

list_literal = { "[" ~ natural_newline* ~ (expr ~ "," ~ natural_newline*)* ~ expr? ~ natural_newline* ~ "]" }

struct_literal_field = { identifier ~ ":" ~ expr }
struct_literal = {
    "{" ~ natural_newline* ~
    (struct_literal_field ~ "," ~ natural_newline*)* ~
    (struct_literal_field ~ natural_newline*)? ~
    "}"
}

typed_struct_literal = { identifier ~ struct_literal }

term = {
    (
    unary
    | string
    | float
    | integer
    | bool
    | function_call
    | list_literal
    | typed_struct_literal
    | struct_literal
    | usable_identifier
//     | ("&" ~ identifier)
//     | ("*" ~ identifier)
    | "(" ~ expr ~ ")"
    )
}

typed_arg = {
    identifier ~ ":" ~ var_type
}

variable_assignment = {
    "let" ~ identifier ~ (":" ~ var_type)? ~ "=" ~ expr
}

assign_op = {
    "=" | "+="
}

variable_reassignment = {
    usable_identifier ~ assign_op ~ expr
}

response = {
    "respond" ~ expr ~ expr
}

return_statement = {
    "return" ~ expr
}

if_statement = _{
    "if" ~ expr ~ block
}

else_if_statement = _{
    "else" ~ "if" ~ expr ~ block
}

else_statement = _{
    "else" ~ block
}

while_loop = {
    "while" ~ expr ~ block
}

for_loop = {
    "for" ~ identifier ~ "in" ~ expr ~ block
}

if_some = {
    "if" ~ "Some" ~ "(" ~ identifier ~ ")" ~ "=" ~ expr ~ block ~
    natural_newline* ~
    ("else" ~ block)?
}

conditional = {
    if_statement ~  natural_newline* ~
    (else_if_statement ~ natural_newline*)*
    ~ natural_newline* ~ (else_statement)?
}

statement = _{
    (function_call ~ explicit_newline)
    | (variable_assignment ~ explicit_newline)
    | (variable_reassignment ~ explicit_newline)
    | (response ~ explicit_newline)
    | (return_statement ~ explicit_newline)
    | if_some
    | conditional
    | while_loop    | for_loop}

function = {
    "func" ~ identifier ~
    "("
    ~ (typed_arg ~ ",")*
    ~ (typed_arg)? ~
    ")"
    ~ ("->" ~ var_type)? ~ block
}

struct_field = {
    identifier ~ ":" ~ var_type ~ ","?
}

struct_decl = {
    "struct" ~ identifier ~
    "{" ~ new_line* ~
    (new_line* ~ struct_field ~ new_line*)* ~
    "}"
}

enclosed_path = {
    "{" ~ identifier ~ "}"
}

// #PATH /user/{id}
path_specifier = {
    "PATH" ~ ("/" ~ (identifier | enclosed_path))* ~ "/"?
}


query = {
    identifier ~ ":" ~ var_type
}

optional_query = {
    query ~ "?"
}

query_specifier = {
    "QUERY" ~ (optional_query | query)
}

header_expect = {
    identifier ~ ":" ~ (string | identifier)
}

header_expect_specifier = {
    "HEADER" ~ "EXPECT" ~ header_expect
}

header_specifier = {
    "HEADER" ~ identifier
}

specifiers = _{
    "#" ~
    (
    path_specifier
    | query_specifier
    | header_expect_specifier
    | header_specifier
    ) ~ natural_newline*
}

method_type = {
    "GET" | "POST" | "PUT" | "DELETE" | "PATCH"
}

method = {
    specifiers* ~ method_type ~ identifier ~
    ("(" ~ (typed_arg ~ ",")* ~ (typed_arg)? ~")")?
    ~ block
}

block = {
    "{" ~ new_line* ~ (new_line* ~ statement ~ new_line*)* ~ new_line* ~ "}"
}

construct = _{
    import_stmt
    | from_import_stmt
    | function
    | method
    | struct_decl
//     | variable_assignment
}

import_stmt = {
    "import" ~ import_path
}

from_import_stmt = {
    "from" ~ import_path ~ "import" ~ identifier
}

instructions = _{
    (new_line* ~ construct ~ new_line?)*
}

program = _{ SOI ~ instructions ~ EOI}