natural_newline = _{"␍␊" | "\r\n" | "\n"}
explicit_newline = _{";"}
new_line = _{natural_newline | explicit_newline}
line_terminator = _{new_line | EOI}

WHITESPACE = _{ " " | "\t" }
float = @{ ("-")? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
integer = @{ ASCII_DIGIT+ }
bool = @{ "true" | "false" }
string = @{ "\"" ~ (("\\\"" | !"\"") ~ ANY)* ~ "\"" }

identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHA | ASCII_DIGIT)* }

number = @{ float | integer }

var_type = { identifier ~ "*"* }

identifier_with_dots = { identifier ~ ("." ~ identifier)+ }
usable_identifier = { identifier_with_dots | identifier }


function_call = {
    usable_identifier ~ "(" ~ natural_newline* ~ (expr ~ "," ~ natural_newline*)* ~ (expr ~ natural_newline*)? ~ ")" ~ natural_newline*
}
eq_ops = { "==" | "!="  | ">=" | "<=" | ">" | "<"}
sum_ops = { "+" | "-" }
prod_ops = { "*" | "/" }

expr = { sum ~ ((eq_ops) ~ sum)* }
sum = { product ~ ((sum_ops) ~ product)* }
product = { term ~ ((prod_ops) ~ term)* }
term = {
    (
    string
    | float
    | integer
    | bool
    | function_call
    | identifier_with_dots
//     | ("&" ~ identifier)
//     | ("*" ~ identifier)
    | usable_identifier
    | "(" ~ expr ~ ")"
    )
}

typed_arg = {
    identifier ~ ":" ~ identifier
}

variable_assignment = {
    "let" ~ identifier ~ (":" ~ identifier)? ~ "=" ~ expr
}

variable_reassignment = {
    usable_identifier ~ "=" ~ expr
}

response = {
    "respond" ~ expr ~ expr
}

return_statement = {
    "return" ~ expr
}

if_statement = _{
    "if" ~ expr ~ block
}

else_if_statement = _{
    "else" ~ "if" ~ expr ~ block
}

else_statement = _{
    "else" ~ block
}

while_loop = {
    "while" ~ expr ~ block
}

conditional = {
    if_statement ~  natural_newline* ~
    (else_if_statement ~ natural_newline*)*
    ~ natural_newline* ~ (else_statement)?
}

statement = _{
    variable_assignment ~ explicit_newline
    | variable_reassignment ~ explicit_newline
    | function_call ~ explicit_newline
    | response ~ explicit_newline
    | return_statement ~ explicit_newline
    | conditional
    | while_loop
}

function = {
    "func" ~ identifier ~
    "("
    ~ (typed_arg ~ ",")*
    ~ (typed_arg)? ~
    ")"
    ~ ("->" ~ identifier)? ~ block
}

enclosed_path = {
    "{" ~ identifier ~ "}"
}

// #PATH /user/{id}
path_specifier = {
    "PATH" ~ identifier ~ (("/" ~ identifier | enclosed_path))* ~ "/"*
}

// #QUERY key: type ?
query_specifier = {
    "QUERY"
}

specifiers = {
    "#" ~
    (
    path_specifier
    )
}

method_type = {
    "GET" | "POST" | "PUT" | "DELETE"
}

method = {
    method_type ~ identifier ~
    ("(" ~ (typed_arg ~ ",")* ~ (typed_arg)? ~")")?
    ~ block
}

block = {
    "{" ~ new_line* ~ (new_line* ~ statement ~ new_line*)* ~ new_line* ~ "}"
}

construct = _{
    function
    | method
//     | variable_assignment
}

instructions = _{
    (new_line* ~ construct ~ new_line?)*
}

program = _{ SOI ~ instructions ~ EOI}